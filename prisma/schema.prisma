// HajjBro - Prisma Schema
// PostgreSQL database for Hajj pilgrimage app

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── User & Auth ─────────────────────────────────────────────────────────────
enum UserRole {
  pilgrim
  admin
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String    @map("password_hash")
  name          String?
  phone         String?
  role          UserRole  @default(pilgrim)
  locale        String?   @default("en")
  fcmToken      String?   @map("fcm_token")
  emailVerified Boolean   @default(false) @map("email_verified")
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  lastLoginAt   DateTime? @map("last_login_at")

  refreshTokens          RefreshToken[]
  checklists             UserChecklist[]
  ritualProgress         UserRitualProgress[]
  notifications          Notification[]
  scheduledNotifications ScheduledNotification[]
  contacts               Contact[]
  kafelasCreated         Kafela[]       @relation("KafelaCreator")
  kafelaMemberships      KafelaMember[]

  @@index([createdAt])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  tokenHash String    @map("token_hash") // bcrypt/sha256 of opaque token
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

// ─── Rituals (e.g. Ihram, Tawaf, Sa'i, Wuquf, etc.) ──────────────────────────
model Ritual {
  id          String   @id @default(cuid())
  slug        String   @unique
  nameEn      String   @map("name_en")
  nameAr      String?  @map("name_ar")
  description String?  @db.Text
  order       Int      @default(0)
  dayOfHajj   Int?     @map("day_of_hajj") // 1-6 typically
  isRequired  Boolean  @default(true) @map("is_required")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  duas            Dua[]
  userProgress    UserRitualProgress[]

  @@index([order])
  @@map("rituals")
}

// ─── Duas (supplications) ────────────────────────────────────────────────────
model Dua {
  id              String   @id @default(cuid())
  slug            String?  @unique
  ritualId        String?  @map("ritual_id")
  titleEn         String?  @map("title_en")
  titleAr         String?  @map("title_ar")
  textAr          String   @map("text_ar") @db.Text
  textEn          String?  @map("text_en") @db.Text
  transliteration String?  @db.Text
  source          String?  // e.g. Quran 2:201
  order           Int      @default(0)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  ritual Ritual? @relation(fields: [ritualId], references: [id], onDelete: SetNull)

  @@index([ritualId])
  @@index([ritualId, order])
  @@map("duas")
}

// ─── Locations (Makkah, Mina, Arafat, Muzdalifah, etc.) ─────────────────────
model Location {
  id          String   @id @default(cuid())
  slug        String   @unique
  nameEn      String   @map("name_en")
  nameAr      String?  @map("name_ar")
  description String?  @db.Text
  latitude    Decimal? @db.Decimal(10, 8)
  longitude   Decimal? @db.Decimal(11, 8)
  type        String   // makkah, mina, arafat, muzdalifah, medina, other
  address     String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  prayerTimes PrayerTime[]

  @@index([type])
  @@index([latitude, longitude])
  @@map("locations")
}

// ─── Checklist (pre-travel, documents, packing, etc.) ────────────────────────
model Checklist {
  id          String   @id @default(cuid())
  slug        String   @unique
  titleEn     String   @map("title_en")
  titleAr     String?  @map("title_ar")
  description String?  @db.Text
  category    String   // pre_travel, documents, packing, during_hajj, post_hajj
  order       Int      @default(0)
  isRequired  Boolean  @default(false) @map("is_required")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  userChecklists UserChecklist[]

  @@index([category])
  @@index([category, order])
  @@map("checklists")
}

// ─── User's checklist progress ──────────────────────────────────────────────
model UserChecklist {
  id          String    @id @default(cuid())
  userId      String    @map("user_id")
  checklistId String    @map("checklist_id")
  completed   Boolean   @default(false)
  completedAt DateTime? @map("completed_at")
  notes       String?   @db.Text
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  checklist Checklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)

  @@unique([userId, checklistId])
  @@map("user_checklists")
}

// ─── User's ritual progress ─────────────────────────────────────────────────
model UserRitualProgress {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  ritualId   String    @map("ritual_id")
  status     String    @default("pending") // pending, in_progress, completed
  completedAt DateTime? @map("completed_at")
  notes      String?   @db.Text
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  ritual Ritual @relation(fields: [ritualId], references: [id], onDelete: Cascade)

  @@unique([userId, ritualId])
  @@index([userId])
  @@index([ritualId])
  @@map("user_ritual_progress")
}

// ─── In-app notifications ───────────────────────────────────────────────────
model Notification {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  title     String
  body      String    @db.Text
  data      String?   @db.Text // JSON payload for deep linking
  read      Boolean   @default(false)
  sentAt    DateTime  @default(now()) @map("sent_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, read])
  @@map("notifications")
}

// ─── Scheduled push notifications (FCM) ─────────────────────────────────────
enum ScheduledNotificationStatus {
  pending
  sent
  failed
}

model ScheduledNotification {
  id            String                     @id @default(cuid())
  userId        String                     @map("user_id")
  title         String
  body          String                     @db.Text
  data          String?                    @db.Text // JSON for deep linking
  scheduledAt   DateTime                   @map("scheduled_at")
  status        ScheduledNotificationStatus @default(pending)
  sentAt        DateTime?                  @map("sent_at")
  retryCount    Int                        @default(0) @map("retry_count")
  maxRetries    Int                        @default(3) @map("max_retries")
  lastAttemptAt DateTime?                 @map("last_attempt_at")
  lastError     String?                    @map("last_error") @db.Text
  createdAt     DateTime                   @default(now()) @map("created_at")
  updatedAt     DateTime                   @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, scheduledAt])
  @@index([userId])
  @@map("scheduled_notifications")
}

// ─── Emergency / travel contacts ─────────────────────────────────────────────
model Contact {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  name        String
  phone       String
  relationship String? // family, group_leader, embassy, other
  isPrimary   Boolean  @default(false) @map("is_primary")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("contacts")
}

// ─── Kafela (pilgrim convoy / travel group) ───────────────────────────────────
enum KafelaMemberRole {
  kafela_admin
  group_admin
  member
}

enum KafelaMemberStatus {
  active
  removed
  left
}

enum BroadcastPriority {
  info
  urgent
}

model Kafela {
  id          String    @id @default(cuid())
  name        String
  joinCode    String    @unique @map("join_code")
  maxMembers  Int       @default(150) @map("max_members")
  startsOn    DateTime? @map("starts_on") @db.Date
  endsOn      DateTime? @map("ends_on") @db.Date
  createdById String    @map("created_by_id")
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  createdBy  User           @relation("KafelaCreator", fields: [createdById], references: [id])
  members    KafelaMember[]
  groups     KafelaGroup[]
  broadcasts Broadcast[]
  sosEvents  SosEvent[]
  rollCalls  RollCall[]

  @@index([joinCode])
  @@index([isActive])
  @@map("kafelas")
}

model KafelaMember {
  id             String             @id @default(cuid())
  userId         String             @map("user_id")
  kafelaId       String             @map("kafela_id")
  role           KafelaMemberRole   @default(member)
  groupId        String?            @map("group_id")
  status         KafelaMemberStatus @default(active)
  sharingEnabled Boolean            @default(false) @map("sharing_enabled")
  displayName    String?            @map("display_name")
  phone          String?
  tentOrRoom     String?            @map("tent_or_room")
  joinedAt       DateTime           @default(now()) @map("joined_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  kafela             Kafela             @relation(fields: [kafelaId], references: [id], onDelete: Cascade)
  group              KafelaGroup?       @relation("GroupMembers", fields: [groupId], references: [id], onDelete: SetNull)
  adminOfGroup       KafelaGroup?       @relation("GroupAdmin")
  location           MemberLocation?
  broadcastsAuthored Broadcast[]        @relation("BroadcastAuthor")
  broadcastAcks      BroadcastAck[]
  sosEvents          SosEvent[]         @relation("SosMember")
  sosResolved        SosEvent[]         @relation("SosResolver")
  rollCallsAuthored  RollCall[]         @relation("RollCallAuthor")
  rollCallResponses  RollCallResponse[]

  @@unique([userId, kafelaId])
  @@index([kafelaId, status])
  @@index([groupId])
  @@index([userId, status])
  @@map("kafela_members")
}

model KafelaGroup {
  id            String   @id @default(cuid())
  kafelaId      String   @map("kafela_id")
  name          String
  color         String   @default("#0d9488")
  adminMemberId String?  @unique @map("admin_member_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  kafela    Kafela         @relation(fields: [kafelaId], references: [id], onDelete: Cascade)
  admin     KafelaMember?  @relation("GroupAdmin", fields: [adminMemberId], references: [id], onDelete: SetNull)
  members   KafelaMember[] @relation("GroupMembers")
  broadcasts Broadcast[]
  rollCalls RollCall[]

  @@index([kafelaId])
  @@map("kafela_groups")
}

model MemberLocation {
  id        String   @id @default(cuid())
  memberId  String   @unique @map("member_id")
  latitude  Decimal  @db.Decimal(10, 8)
  longitude Decimal  @db.Decimal(11, 8)
  accuracy  Float?
  battery   Int?
  updatedAt DateTime @updatedAt @map("updated_at")
  createdAt DateTime @default(now()) @map("created_at")

  member KafelaMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@map("member_locations")
}

model Broadcast {
  id        String            @id @default(cuid())
  kafelaId  String            @map("kafela_id")
  groupId   String?           @map("group_id")
  authorId  String            @map("author_id")
  title     String
  body      String            @db.Text
  priority  BroadcastPriority @default(info)
  rallyLat  Decimal?          @map("rally_lat") @db.Decimal(10, 8)
  rallyLng  Decimal?          @map("rally_lng") @db.Decimal(11, 8)
  createdAt DateTime          @default(now()) @map("created_at")

  kafela Kafela         @relation(fields: [kafelaId], references: [id], onDelete: Cascade)
  group  KafelaGroup?   @relation(fields: [groupId], references: [id], onDelete: SetNull)
  author KafelaMember   @relation("BroadcastAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  acks   BroadcastAck[]

  @@index([kafelaId, createdAt])
  @@index([groupId])
  @@map("broadcasts")
}

model BroadcastAck {
  id          String   @id @default(cuid())
  broadcastId String   @map("broadcast_id")
  memberId    String   @map("member_id")
  seenAt      DateTime @default(now()) @map("seen_at")

  broadcast Broadcast    @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  member    KafelaMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([broadcastId, memberId])
  @@index([memberId])
  @@map("broadcast_acks")
}

model SosEvent {
  id           String    @id @default(cuid())
  kafelaId     String    @map("kafela_id")
  memberId     String    @map("member_id")
  latitude     Decimal?  @db.Decimal(10, 8)
  longitude    Decimal?  @db.Decimal(11, 8)
  note         String?   @db.Text
  resolvedAt   DateTime? @map("resolved_at")
  resolvedById String?   @map("resolved_by_id")
  createdAt    DateTime  @default(now()) @map("created_at")

  kafela     Kafela        @relation(fields: [kafelaId], references: [id], onDelete: Cascade)
  member     KafelaMember  @relation("SosMember", fields: [memberId], references: [id], onDelete: Cascade)
  resolvedBy KafelaMember? @relation("SosResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([kafelaId, resolvedAt])
  @@index([memberId])
  @@map("sos_events")
}

model RollCall {
  id        String   @id @default(cuid())
  kafelaId  String   @map("kafela_id")
  groupId   String?  @map("group_id")
  authorId  String   @map("author_id")
  title     String
  createdAt DateTime @default(now()) @map("created_at")
  closedAt  DateTime? @map("closed_at")

  kafela    Kafela             @relation(fields: [kafelaId], references: [id], onDelete: Cascade)
  group     KafelaGroup?       @relation(fields: [groupId], references: [id], onDelete: SetNull)
  author    KafelaMember       @relation("RollCallAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  responses RollCallResponse[]

  @@index([kafelaId, createdAt])
  @@map("roll_calls")
}

model RollCallResponse {
  id          String   @id @default(cuid())
  rollCallId  String   @map("roll_call_id")
  memberId    String   @map("member_id")
  present     Boolean  @default(true)
  respondedAt DateTime @default(now()) @map("responded_at")

  rollCall RollCall     @relation(fields: [rollCallId], references: [id], onDelete: Cascade)
  member   KafelaMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([rollCallId, memberId])
  @@index([memberId])
  @@map("roll_call_responses")
}

// ─── Prayer times (per location/date) ─────────────────────────────────────────
model PrayerTime {
  id         String   @id @default(cuid())
  locationId String   @map("location_id")
  date       DateTime @db.Date
  fajr       String   // HH:mm
  sunrise    String?  @map("sunrise")
  dhuhr      String
  asr        String
  maghrib    String
  isha       String
  source     String?  // api or manual
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([locationId, date])
  @@index([locationId])
  @@index([date])
  @@map("prayer_times")
}
